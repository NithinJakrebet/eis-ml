figure.dpi: 300
savefig.dpi: 300
savefig.bbox: tight
savefig.pad_inches: 0.02
figure.figsize: 3.5, 2.6   # ~Nature single column (89 mm)

font.family: DejaVu Sans
font.size: 8.5
axes.titlesize: 9.5
axes.labelsize: 9
xtick.labelsize: 8
ytick.labelsize: 8
legend.fontsize: 8

axes.linewidth: 0.8
axes.spines.top: False
axes.spines.right: False
axes.grid: True
grid.linestyle: :
grid.linewidth: 0.4
grid.alpha: 0.5

xtick.direction: in
ytick.direction: in
xtick.major.size: 3
ytick.major.size: 3
xtick.minor.size: 2
ytick.minor.size: 2
xtick.minor.visible: True
ytick.minor.visible: True

lines.linewidth: 1.4
lines.markersize: 4
errorbar.capsize: 2

legend.frameon: False
legend.handlelength: 2
legend.borderaxespad: 0.6

# Color cycle: Okabe–Ito (colorblind-safe)
axes.prop_cycle: cycler(color=['#0072B2', '#E69F00', '#009E73', '#D55E00', '#CC79A7', '#56B4E9', '#F0E442', '#000000'])
